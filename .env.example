# DeepCatalog — copy to .env and adjust.
# Prefer the web UI for provider setup: Settings → AI provider.

# --- Storage ---
DATA_DIR=./data

# --- Web server (manual uvicorn / systemd autostart) ---
# DEEPCATALOG_HOST=127.0.0.1
# DEEPCATALOG_PORT=8080
# DEEPCATALOG_LOG_LEVEL=warning          # desktop wrapper only
#
# Non-loopback binds (0.0.0.0, LAN IP) require ALL of:
#   DEEPCATALOG_ALLOW_REMOTE=1
#   DEEPCATALOG_API_TOKEN=…
#   DEEPCATALOG_SSL_CERTFILE=… and DEEPCATALOG_SSL_KEYFILE=… (HTTPS on uvicorn)
# Prefer local mode instead: DEEPCATALOG_HOST=127.0.0.1 + TLS reverse proxy (see README).
# DEEPCATALOG_ALLOW_REMOTE=0
# DEEPCATALOG_SSL_CERTFILE=/path/to/fullchain.pem
# DEEPCATALOG_SSL_KEYFILE=/path/to/privkey.pem
# Browser sessions (deepcatalog_session cookie) last this many seconds (default 86400 = 24h).
# DEEPCATALOG_SESSION_TTL_SECONDS=86400
# First launch writes a random DEEPCATALOG_API_TOKEN into DATA_DIR/.env (mode 0600).
# Loopback is not trusted: other local accounts can reach 127.0.0.1. Paste that token
# in the unlock panel, or use the desktop window (one-time bootstrap). Override here:
# DEEPCATALOG_API_TOKEN=
# Dedicated single-user machine only — restores “anyone on loopback is authenticated”:
# DEEPCATALOG_SINGLE_USER=1
# Optional Host allowlist (comma-separated). Defaults include localhost / 127.0.0.1.
# DEEPCATALOG_ALLOWED_HOSTS=localhost,127.0.0.1,deepcatalog.example.com
# Trust X-Forwarded-For / X-Forwarded-Proto ONLY from these proxy IPs/CIDRs
# (client IP / HTTPS detection — never used to skip authentication).
# Catch-alls such as 0.0.0.0/0 and ::/0 are ignored.
# DEEPCATALOG_TRUSTED_PROXIES=127.0.0.1,::1

# --- LLM provider ---
# gemini | openai | ollama  (openai also accepts alias "codex")
# Leave unset to auto-detect: OpenAI key → Gemini key → running local Ollama → Gemini.
DEEPCATALOG_LLM_PROVIDER=openai
# DEEPCATALOG_SKIP_OLLAMA_PROBE=1        # skip localhost Ollama probe during auto-detect

# --- OpenAI / Codex ---
# Preferred: Settings → Cloud (ChatGPT) → Sign in with ChatGPT (OAuth).
# Alternative: paste a Platform API key in the UI or here.
OPENAI_API_KEY=

DEEPCATALOG_MODEL=gpt-5.6-luna
DEEPCATALOG_EMBEDDING_MODEL=text-embedding-3-small
# DEEPCATALOG_CODEX_MODEL=gpt-5.6-terra  # ChatGPT OAuth model override
# ChatGPT OAuth (no Platform API key) uses local ONNX MiniLM embeddings for RAG;
# Platform embedding APIs require an API key. Switching providers auto-rebuilds the index.
# Ask: drop semantic hits farther than this cosine distance (0 = identical).
# DEEPCATALOG_ASK_MAX_CHUNK_DISTANCE=0.55

# --- Gemini ---
# DEEPCATALOG_LLM_PROVIDER=gemini
# GOOGLE_API_KEY=
# DEEPCATALOG_MODEL=gemini-flash-latest
# DEEPCATALOG_EMBEDDING_MODEL=text-embedding-004

# --- Ollama (fully local by default) ---
# Easiest: Settings → Local Ollama → Pull required models.
# Needs a multimodal chat model (default gemma3) plus nomic-embed-text:
#   ollama pull gemma3 && ollama pull nomic-embed-text
# DEEPCATALOG_LLM_PROVIDER=ollama
# DEEPCATALOG_MODEL=gemma3
# DEEPCATALOG_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_BASE_URL=http://localhost:11434
# Local mode only allows localhost / 127.0.0.1 / ::1.
# Remote Ollama (LAN / another host) requires an explicit opt-in and the same
# privacy disclaimer as cloud AI (documents leave this machine):
# DEEPCATALOG_ALLOW_REMOTE_OLLAMA=1
# OLLAMA_BASE_URL=http://192.168.1.10:11434
# Remote DNS names must also be listed (literal IPs cannot rebind):
# DEEPCATALOG_OLLAMA_ALLOWED_HOSTS=gpu.lan,192.168.1.10

# --- Untrusted media (PDF/image) ---
# DEEPCATALOG_MEDIA_MAX_IMAGE_PIXELS=40000000
# DEEPCATALOG_MEDIA_MAX_PDF_PAGES=128          # also rejects at upload
# DEEPCATALOG_MEDIA_MAX_PDF_PAGE_POINTS=14400  # MediaBox cap (~200 in)
# DEEPCATALOG_MEDIA_WORKER=1                   # isolate Poppler/Pillow/pypdf
# DEEPCATALOG_MEDIA_WORKER_TIMEOUT_S=90
# DEEPCATALOG_MEDIA_WORKER_MEMORY_MB=4096      # virtual AS cap (Poppler needs headroom)
# DEEPCATALOG_MEDIA_WORKER_CPU_S=120

# --- LLM timeouts (seconds) ---
# DEEPCATALOG_LLM_TIMEOUT=120
# DEEPCATALOG_LLM_VISION_TIMEOUT=300
# DEEPCATALOG_OLLAMA_TIMEOUT=300
# DEEPCATALOG_CANCEL_JOIN_TIMEOUT=3      # max wait when joining a cancelled LLM call

# --- OCR / long documents ---
# Adaptive modes: fast | balanced | maximum (Settings → Filing can also set this)
# DEEPCATALOG_OCR_MODE=balanced
# DEEPCATALOG_OCR_CONCURRENCY=4          # parallel vision pages (cloud)
# DEEPCATALOG_OCR_CONCURRENCY_OLLAMA=1   # parallel vision pages (local Ollama)
# Default: process all PDF pages (up to DEEPCATALOG_OCR_SAFETY_MAX_PAGES).
# DEEPCATALOG_OCR_MAX_PAGES=0            # 0 = all pages; e.g. 8 on slow hardware
# DEEPCATALOG_OCR_SAFETY_MAX_PAGES=128
# DEEPCATALOG_OCR_DPI=200
# DEEPCATALOG_OCR_PAGE_TIMEOUT=180       # per-page timeout (cloud)
# DEEPCATALOG_OLLAMA_OCR_PAGE_TIMEOUT=900  # per-page timeout (local Ollama / CPU)
# DEEPCATALOG_OCR_MAX_IMAGE_PX=1536      # downscale page images before vision OCR
# DEEPCATALOG_OLLAMA_OCR_MAX_IMAGE_PX=1024  # tighter cap for local Ollama on CPU
# DEEPCATALOG_OLLAMA_OCR_NUM_CTX=4096
# DEEPCATALOG_OLLAMA_OCR_NUM_PREDICT=4096
# DEEPCATALOG_OLLAMA_VISION_NUM_CTX=8192
# DEEPCATALOG_OLLAMA_VISION_NUM_PREDICT=8192
# DEEPCATALOG_EXTRACT_MAX_CHARS=48000    # OCR text budget for metadata extraction

# --- Updates ---
# In-app updater always uses dpastoetter/DeepCatalog (env cannot redirect it).
# Fresh-install scripts still honor DEEPCATALOG_UPDATE_REPO for forks.

# --- Internal (set by systemd unit; do not edit manually) ---
# DEEPCATALOG_SYSTEMD=1
