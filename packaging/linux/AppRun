#!/usr/bin/env bash
# DeepCatalog AppImage entrypoint.
# Bundled WebKitGTK/GTK live in usr/lib/deepcatalog-webkit (GI typelibs alongside).
# Host libc / libGL / X11 / Wayland stay on the OS. Poppler uses RPATH.
set -euo pipefail

SELF="$(readlink -f "$0")"
HERE="${APPDIR:-$(dirname "$SELF")}"

export APPDIR="$HERE"
export DEEPCATALOG_APPIMAGE="${DEEPCATALOG_APPIMAGE:-1}"
export DEEPCATALOG_PROJECT_ROOT="${DEEPCATALOG_PROJECT_ROOT:-$HERE/opt/deepcatalog}"
export DATA_DIR="${DATA_DIR:-$HOME/.local/share/deepcatalog}"
export PYTHONNOUSERSITE=1
export PYTHONPATH="${DEEPCATALOG_PROJECT_ROOT}${PYTHONPATH:+:$PYTHONPATH}"

# Official Ollama installs to ~/.local/bin; .desktop launches often omit it.
export PATH="$HERE/usr/bin:${HOME:+$HOME/.local/bin:}${PATH:-}"

WEBKIT_DIR="$HERE/usr/lib/deepcatalog-webkit"
if [ -d "$WEBKIT_DIR" ]; then
  export LD_LIBRARY_PATH="${WEBKIT_DIR}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
if [ -d "$HERE/usr/lib/girepository-1.0" ]; then
  export GI_TYPELIB_PATH="$HERE/usr/lib/girepository-1.0${GI_TYPELIB_PATH:+:$GI_TYPELIB_PATH}"
fi
if [ -d "$HERE/usr/lib/webkit2gtk-4.1" ]; then
  wk_helpers="$HERE/usr/lib/webkit2gtk-4.1"
  wk_link="/tmp/.dc/x86_64-linux-gnu/webkit2gtk-4.1"
elif [ -d "$HERE/usr/lib/webkit2gtk-4.0" ]; then
  wk_helpers="$HERE/usr/lib/webkit2gtk-4.0"
  wk_link="/tmp/.dc/x86_64-linux-gnu/webkit2gtk-4.0"
else
  wk_helpers=""
  wk_link=""
fi
# Release WebKitGTK ignores WEBKIT_EXEC_PATH; the .so is patched to $wk_link.
if [ -n "$wk_link" ]; then
  mkdir -p "$(dirname "$wk_link")"
  ln -sfn "$wk_helpers" "$wk_link"
  export WEBKIT_EXEC_PATH="$wk_helpers"
  if [ -d "$wk_helpers/injected-bundle" ]; then
    export WEBKIT_INJECTED_BUNDLE_PATH="$wk_helpers/injected-bundle"
  fi
fi
# bwrap sandbox cannot see the AppImage mount as a normal rootfs.
export WEBKIT_FORCE_SANDBOX="${WEBKIT_FORCE_SANDBOX:-0}"
export WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS="${WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS:-1}"
# Bundled WebKit on Fedora/NVIDIA/Wayland often paints a black view otherwise.
export WEBKIT_DISABLE_COMPOSITING_MODE="${WEBKIT_DISABLE_COMPOSITING_MODE:-1}"
export WEBKIT_DISABLE_DMABUF_RENDERER="${WEBKIT_DISABLE_DMABUF_RENDERER:-1}"

# Capture the session color-scheme before isolating GSettings (memory backend
# would hide dconf, and a light Adwaita CSD on a dark desktop looks wrong).
if [ -z "${DEEPCATALOG_GTK_DARK:-}" ]; then
  scheme=""
  gtk_th=""
  gsettings_bin=""
  if [ -x /usr/bin/gsettings ]; then
    gsettings_bin=/usr/bin/gsettings
  elif command -v gsettings >/dev/null 2>&1; then
    gsettings_bin="$(command -v gsettings)"
  fi
  if [ -n "$gsettings_bin" ]; then
    scheme=$("$gsettings_bin" get org.gnome.desktop.interface color-scheme 2>/dev/null || true)
    gtk_th=$("$gsettings_bin" get org.gnome.desktop.interface gtk-theme 2>/dev/null || true)
  fi
  case "$scheme" in
    *prefer-dark*) export DEEPCATALOG_GTK_DARK=1 ;;
    *prefer-light*) export DEEPCATALOG_GTK_DARK=0 ;;
    *)
      case "$gtk_th" in
        *[Dd]ark*) export DEEPCATALOG_GTK_DARK=1 ;;
        *) export DEEPCATALOG_GTK_DARK=0 ;;
      esac
      ;;
  esac
fi
if [ "${DEEPCATALOG_GTK_DARK:-0}" = "1" ]; then
  # Adwaita:dark is required for CSD; prefer-dark alone is ignored when
  # GTK_THEME=Adwaita (light) is set.
  export GTK_THEME="${GTK_THEME:-Adwaita:dark}"
else
  export GTK_THEME="${GTK_THEME:-Adwaita}"
fi

# Do not replace XDG_CONFIG_HOME — that hid portals/user-dirs and aborted
# launch on Debian when combined with an early Gtk 4 GI bind.

# Bundled GTK must use the Ubuntu Adwaita copied at pack time — host GTK CSS
# (Fedora 42+) is newer than the builder's GTK 3.24 and leaves CSD buttons blank.
export XDG_DATA_DIRS="$HERE/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export XDG_CONFIG_DIRS="$HERE/etc:${XDG_CONFIG_DIRS:-/etc/xdg}"
export GTK_DATA_PREFIX="${GTK_DATA_PREFIX:-$HERE/usr}"
# Host GNOME file portal (so the picker sees PDF MIME types from the OS).
export GTK_USE_PORTAL="${GTK_USE_PORTAL:-1}"
# Ignore session dconf (Fedora icon themes the bundled pixbuf cannot render).
export GSETTINGS_BACKEND="${GSETTINGS_BACKEND:-memory}"
if [ -d "$HERE/usr/share/glib-2.0/schemas" ]; then
  export GSETTINGS_SCHEMA_DIR="$HERE/usr/share/glib-2.0/schemas"
fi
if [ -d "$HERE/usr/lib/gio/modules" ]; then
  export GIO_MODULE_DIR="$HERE/usr/lib/gio/modules"
fi

PIXBUF_LOADERS="$HERE/usr/lib/gdk-pixbuf-2.0/loaders"
if [ -d "$PIXBUF_LOADERS" ]; then
  export GDK_PIXBUF_MODULEDIR="$PIXBUF_LOADERS"
  cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/deepcatalog"
  mkdir -p "$cache_dir"
  # Host gdk-pixbuf-query-loaders writes OS .so paths that cannot load under
  # the bundled gdk-pixbuf — CSD icons then render as empty boxes.
  query="$HERE/usr/bin/gdk-pixbuf-query-loaders"
  if [ -x "$query" ]; then
    shopt -s nullglob
    loaders=( "$PIXBUF_LOADERS"/*.so )
    shopt -u nullglob
    export GDK_PIXBUF_MODULE_FILE="$cache_dir/gdk-pixbuf-loaders.cache"
    if [ "${#loaders[@]}" -eq 0 ] || ! "$query" "${loaders[@]}" > "$GDK_PIXBUF_MODULE_FILE" 2>/dev/null; then
      unset GDK_PIXBUF_MODULE_FILE
    fi
  fi
fi

cd "$DEEPCATALOG_PROJECT_ROOT"

exec "$HERE/usr/bin/python3" -m deepcatalog.desktop "$@"
